{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "jobaid.yaml — dedicated job-aid input for tcs-render-lesson/scripts/jobaid.py",
 "type": "object",
 "required": ["title", "language", "blocks"],
 "properties": {
  "schema": {"const": "tcs-jobaid/1.0"},
  "title": {"type": "string"},
  "kicker": {"type": "string"},
  "subtitle": {"type": "string"},
  "language": {"enum": ["en-US", "en-GB", "ar-EG", "ar-MSA"]},
  "direction": {"enum": ["ltr", "rtl"]},
  "paper": {"enum": ["A4", "Letter"]},
  "pages": {"enum": [1, 2]},
  "theme": {"type": "object"},
  "footer": {"type": "string"},
  "source_lesson": {"type": "string"},
  "blocks": {
   "type": "array", "minItems": 1,
   "items": {
    "type": "object", "required": ["type"],
    "properties": {
     "type": {"enum": ["checklist", "steps", "do_dont", "table", "bullets", "definition", "comparison", "icon_grid", "statement", "note"]}
    }
   }
  }
 }
}
